# =============================================================================
# PriceLens — Environment Configuration Template (.env.example)
# Copy this file to .env for local development: cp .env.example .env
# Never commit real secrets or API keys to version control.
# =============================================================================

# --- Database (PostgreSQL 16) ---
DATABASE_URL="postgresql://pricelens:pricelens_dev@localhost:5432/pricelens"

# --- Authentication (Better Auth) ---
BETTER_AUTH_SECRET="pricelens-dev-only-secret-change-in-production-32b"
BETTER_AUTH_URL="http://localhost:8787"

# --- API & Web Application URLs ---
API_PORT="8787"
NEXT_PUBLIC_API_URL="http://localhost:8787/api/v1"
NEXT_PUBLIC_AUTH_URL="http://localhost:8787"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081"

# --- Bot Protection (Cloudflare Turnstile) ---
# Official Cloudflare always-passes test keys for local development
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- Transactional Email (Resend) ---
# Leave empty in local development to use safe console/database dry-run mode
RESEND_API_KEY=""
EMAIL_FROM="PriceLens Alerts <alerts@pricelens.co.th>"

# --- Error Monitoring (Sentry) ---
SENTRY_DSN=""

# --- Runtime Environment ---
NODE_ENV="development"
